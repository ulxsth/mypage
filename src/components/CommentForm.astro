---
---

<div class="comment-section">
  <div class="comment-header">
    <h3>コメントを送信</h3>
    <small>記事の感想や修正依頼等を送っていただけるとよろこびます</small>
  </div>
  <p id="comment-availability" role="status">コメントの受付状況を確認しています…</p>
  <form id="comment-form" class="comment-form" hidden>
    <div class="form-group">
      <label for="email">メールアドレス *</label>
      <input type="email" id="email" name="email" maxlength="254" autocomplete="email" required />
    </div>

    <div class="form-group">
      <label for="message">コメント *</label>
      <textarea id="message" name="message" rows="5" maxlength="5000" required></textarea>
    </div>

    <div id="comment-turnstile"></div>
    <button type="submit" class="submit-btn" disabled>送信</button>
    <div class="form-message" id="form-message" role="status"></div>
  </form>
</div>

<script>
  interface Turnstile {
    render(container: HTMLElement, options: Record<string, unknown>): string;
    reset(widget: string): void;
  }
  const form = document.getElementById('comment-form');
  const availability = document.getElementById('comment-availability');
  const messageDiv = document.getElementById('form-message');
  const challengeContainer = document.getElementById('comment-turnstile');
  const emailInput = document.getElementById('email');
  const messageInput = document.getElementById('message');
  const submit = form?.querySelector('button[type="submit"]');

  if (form instanceof HTMLFormElement && availability instanceof HTMLElement &&
    messageDiv instanceof HTMLElement && challengeContainer instanceof HTMLElement &&
    emailInput instanceof HTMLInputElement && messageInput instanceof HTMLTextAreaElement &&
    submit instanceof HTMLButtonElement) {
    let token = '';
    let widget: string | undefined;
    let challenge: Turnstile | undefined;
    let sending = false;
    const showMessage = (message: string, success = false) => {
      messageDiv.textContent = message;
      messageDiv.className = `form-message form-message--${success ? 'success' : 'error'}`;
      messageDiv.style.display = 'block';
    };
    const resetChallenge = () => {
      token = '';
      submit.disabled = true;
      if (widget !== undefined) challenge?.reset(widget);
    };

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (sending || !token || !form.reportValidity()) return;
      sending = true;
      submit.disabled = true;
      submit.textContent = '送信中…';
      try {
        const response = await fetch('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: emailInput.value.trim(), message: messageInput.value.trim(), token }),
        });
        const result = await response.json();
        if (response.ok) {
          showMessage('コメントを送信しました！', true);
          form.reset();
        } else {
          showMessage(typeof result.error === 'string' ? result.error : '送信できませんでした。');
        }
      } catch {
        showMessage('通信エラーが発生しました。時間をおいてお試しください。');
      } finally {
        sending = false;
        submit.textContent = '送信';
        resetChallenge();
      }
    });

    const loadForm = async () => {
      try {
        const response = await fetch('/api/comments', { cache: 'no-store' });
        const config = await response.json();
        if (!response.ok || config.available !== true || typeof config.siteKey !== 'string') {
          availability.textContent = '現在コメントの受付を停止しています。';
          return;
        }
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
        script.async = true;
        script.onload = () => {
          challenge = (window as Window & { turnstile?: Turnstile }).turnstile;
          if (!challenge) {
            availability.textContent = '確認チェックを読み込めませんでした。';
            return;
          }
          form.hidden = false;
          availability.hidden = true;
          widget = challenge.render(challengeContainer, {
            sitekey: config.siteKey,
            action: 'comment',
            callback: (value: string) => { token = value; submit.disabled = sending; },
            'expired-callback': () => { token = ''; submit.disabled = true; },
            'error-callback': () => { token = ''; submit.disabled = true; showMessage('確認チェックをやり直してください。'); },
          });
        };
        script.onerror = () => { availability.textContent = '確認チェックを読み込めませんでした。'; };
        document.head.append(script);
      } catch {
        availability.textContent = '現在コメントの受付を停止しています。';
      }
    };
    void loadForm();
  }
</script>

<style>
  .comment-form[hidden] { display: none; }
  .comment-section {
    width: 85%;
    max-width: 740px;
    margin: 3em auto;
    padding: 2em;
    border-top: 2px solid var(--gray-light);
  }

  .comment-section h3 {
    margin-top: 0;
    color: var(--gray-dark);
  }

  .comment-header {
    margin-bottom: 1.5em;
  }

  .comment-form {
    display: flex;
    flex-direction: column;
    gap: 1.5em;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
  }

  label {
    font-weight: 600;
    color: var(--gray-dark);
    font-size: 0.95em;
  }

  input[type='text'],
  input[type='email'],
  textarea {
    padding: 0.75em;
    border: 1px solid var(--gray-light);
    border-radius: 6px;
    font-family: inherit;
    font-size: 1em;
    color: var(--gray-dark);
    background-color: var(--surface);
    transition: border-color 0.2s, background-color 0.2s, color 0.2s;
  }

  input[type='text']::placeholder,
  input[type='email']::placeholder,
  textarea::placeholder {
    color: var(--gray);
  }

  input[type='text']:focus,
  input[type='email']:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
  }

  textarea {
    resize: vertical;
    width: auto;
    min-height: 120px;
  }

  .submit-btn {
    padding: 0.75em 1.5em;
    background-color: var(--accent);
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
    align-self: flex-start;
  }

  .submit-btn:hover:not(:disabled) {
    opacity: 0.9;
  }

  .submit-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-message {
    display: none;
    padding: 1em;
    border-radius: 6px;
    font-weight: 500;
  }

  .form-message--success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .form-message--error {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @media (max-width: 768px) {
    .comment-section {
      width: 100%;
      padding: 1.5em 1em;
    }

    input[type='text'],
    input[type='email'],
    textarea {
      font-size: 16px;
    }
  }
</style>
